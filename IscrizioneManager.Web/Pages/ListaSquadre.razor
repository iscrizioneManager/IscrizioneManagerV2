@page "/squadre"
@inject IJSRuntime JS

<link href="css/ListaSquadre.css" rel="stylesheet" />

<LoadingView @ref="LoadingOverlay" />

<div class="header-iscrizione">
    <h2>Squadre</h2>
    <button class="btn-chiudi" @onclick="TornaIndietro" title="Chiudi">×</button>
</div>

<div class="squadre-grid">
    @foreach (var squadra in Squadre)
    {
        <div class="squadra-card">
            <div class="squadra-header"
                 style="background-color:@squadra.Color; color:@GetTextColor(squadra.Color)">
                @squadra.Nome (@squadra.Bambini.Count)
            </div>
            <ul class="squadra-bambini" id="squadra-@squadra.Id">
                @foreach (var b in squadra.Bambini)
                {
                    <li data-id="@b.Id">@b.Nome @b.Cognome</li>
                }
            </ul>
        </div>
    }
</div>

@if (!DragAndDropOn)
{
    <button @onclick="ActivateDragDrop">Modifica</button>
}
else
{
    <button @onclick="StopDragDrop">Salva</button>
    <button @onclick="RidistriubisciSquadre">Ridistribuisci automaticamente</button>
}

<script>
    let draggedId = null;
    let dragListenersAdded = false;

    function initDragDrop() {
        if (dragListenersAdded) return; // evita doppio binding
        dragListenersAdded = true;

        document.querySelectorAll('.squadra-bambini li').forEach(li => {
            li.setAttribute('draggable', 'true');

            li.addEventListener('dragstart', dragStartHandler);
        });

        document.querySelectorAll('.squadra-bambini').forEach(ul => {
            ul.addEventListener('dragover', dragOverHandler);
            ul.addEventListener('drop', dropHandler);
        });
    }

    function stopDragDrop() {
        if (!dragListenersAdded) return;
        dragListenersAdded = false;

        document.querySelectorAll('.squadra-bambini li').forEach(li => {
            li.removeAttribute('draggable');
            li.removeEventListener('dragstart', dragStartHandler);
        });

        document.querySelectorAll('.squadra-bambini').forEach(ul => {
            ul.removeEventListener('dragover', dragOverHandler);
            ul.removeEventListener('drop', dropHandler);
        });
    }

    function dragStartHandler(ev) {
        draggedId = ev.target.dataset.id;
        ev.dataTransfer.setData("text/plain", draggedId);
        ev.dataTransfer.effectAllowed = "move";
    }

    function dragOverHandler(ev) {
        ev.preventDefault();
        ev.dataTransfer.dropEffect = "move";
    }

    function dropHandler(ev) {
        ev.preventDefault();
        const id = ev.dataTransfer.getData("text/plain");
        if (!id) return;

        const li = document.querySelector(`li[data-id='${id}']`);
        if (li) ev.currentTarget.appendChild(li);

        const squadraId = parseInt(ev.currentTarget.id.split('-')[1]);
        DotNet.invokeMethodAsync('IscrizioniManager.Web', 'AggiornaSquadra', parseInt(id), squadraId);
    }
</script>

@code {
    private LoadingView? LoadingOverlay;
    private List<Squadra> Squadre = new();

    protected override async Task OnInitializedAsync()
    {
        LoadingOverlay?.Start();
        Squadre = await SquadraBambinoController.GetSquadreAsync();
        foreach (var s in Squadre) s.IsExpanded = true;
        LoadingOverlay?.Stop();
    }

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private void TornaIndietro() => Navigation.NavigateTo("", true);

    string GetTextColor(string? hex)
    {
        if (string.IsNullOrWhiteSpace(hex)) return "black";
        if (hex.StartsWith("#")) hex = hex.Substring(1);
        if (hex.Length == 3) hex = string.Concat(hex[0], hex[0], hex[1], hex[1], hex[2], hex[2]);
        if (hex.Length != 6) return "black";

        int r = Convert.ToInt32(hex.Substring(0, 2), 16);
        int g = Convert.ToInt32(hex.Substring(2, 2), 16);
        int b = Convert.ToInt32(hex.Substring(4, 2), 16);
        double luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
        return luminance > 0.6 ? "black" : "white";
    }

    [JSInvokable]
    public static Task AggiornaSquadra(int bambinoId, int squadraId)
    {
        // Aggiorna la tua lista in memoria o DB
        Console.WriteLine($"Bambino {bambinoId} spostato in squadra {squadraId}");
        return Task.CompletedTask;
    }

    private bool DragAndDropOn = false;
    private async Task ActivateDragDrop()
    {
        DragAndDropOn = true;
        await JS.InvokeVoidAsync("initDragDrop");
    }

    private async Task StopDragDrop()
    {
        await JS.InvokeVoidAsync("stopDragDrop");
        DragAndDropOn = false;
    }

    private void RidistriubisciSquadre()
    {
        // 1. prendi tutti i bambini
        var tutti = Squadre.SelectMany(s => s.Bambini).ToList();

        // 2. svuota le squadre
        foreach (var s in Squadre)
            s.Bambini.Clear();

        // 3. raggruppa per annata
        var gruppiPerAnno = tutti
            .GroupBy(b => b.Anno)
            .OrderBy(g => g.Key);

        int index = 0;

        // 4. distribuzione round-robin
        foreach (var gruppo in gruppiPerAnno)
        {
            var bambini = gruppo
                .OrderBy(_ => Guid.NewGuid()) // randomizza
                .ToList();

            foreach (var bambino in bambini)
            {
                Squadre[index].Bambini.Add(bambino);

                index++;
                if (index >= Squadre.Count)
                    index = 0;
            }
        }

        StateHasChanged();
    }
}