@page "/squadre"
@using IscrizioneManager.Web.Sortable
@using IscrizioniManager.Models
@inject NavigationManager Navigation

<link href="css/ListaSquadre.css" rel="stylesheet" />

<LoadingView @ref="LoadingOverlay" />

<div class="header-iscrizione">
    <h2>Squadre</h2>

    @if (!isEditing)
    {
        <button class="btn-chiudi" @onclick="EnableEditing">Modifica</button>
    }
    else
    {
        <div class="editing-buttons">
            <button class="btn-chiudi" @onclick="CancelEditing">Annulla modifica</button>
            <button class="btn-squadre" @onclick="RidistriubisciSquadre">Ridistribuisci automaticamente</button>
        </div>
    }
</div>

<div class="squadre-container full-width">

    <div class="squadra-card full-width">
        <div class="squadra-header"
        style="background-color:@Squadra1.Color; color:@GetTextColor(Squadra1.Color)">
            @Squadra1.Nome (@Squadra1.Bambini.Count)
        </div>

        <SortableList Items="Squadra1.Bambini"
        Group="bambiniGroup"
        Context="item"
        >
            <SortableItemTemplate>
                <div class="card has-border has-background-white">
                    <p class="is-size-4 p-2 ml-4">@item.Cognome @item.Nome</p>
                </div>
            </SortableItemTemplate>
        </SortableList>
    </div>

    <div class="squadra-card full-width">
        <div class="squadra-header"
        style="background-color:@Squadra2.Color; color:@GetTextColor(Squadra2.Color)">
            @Squadra2.Nome (@Squadra2.Bambini.Count)
        </div>

        <SortableList Items="Squadra2.Bambini"
        Group="bambiniGroup"
        Context="item"
        >
            <SortableItemTemplate>
                <div class="card has-border has-background-white">
                    <p class="is-size-4 p-2 ml-4">@item.Cognome @item.Nome</p>
                </div>
            </SortableItemTemplate>
        </SortableList>
    </div>

    <div class="squadra-card full-width">
        <div class="squadra-header"
        style="background-color:@SenzaSquadra.Color; color:@GetTextColor(SenzaSquadra.Color)">
            @SenzaSquadra.Nome (@SenzaSquadra.Bambini.Count)
        </div>

        <SortableList Items="SenzaSquadra.Bambini"
        Group="bambiniGroup"
        Context="item"
        >
            <SortableItemTemplate>
                <div class="card has-border has-background-white">
                    <p class="is-size-4 p-2 ml-4">@item.Cognome @item.Nome</p>
                </div>
            </SortableItemTemplate>
        </SortableList>
    </div>
</div>

@code {
    private LoadingView? LoadingOverlay;

    private List<Squadra> Squadre = new();
    private List<Squadra> OriginalSquadre = new();
    private Squadra Squadra1 = new();
    private Squadra Squadra2 = new();
    private Squadra Squadra3 = new();
    private Squadra Squadra4 = new();
    private Squadra SenzaSquadra = new();
    private bool isEditing = false;

    protected override async Task OnInitializedAsync()
    {
        LoadingOverlay?.Start();
        Squadre = await SquadraBambinoController.GetSquadreAsync();
        Squadra1 = Squadre[0];
        Squadra2 = Squadre[1];
        Squadra3 = Squadre[2];
        Squadra4 = Squadre[3];
        SenzaSquadra = Squadre[^1];
        LoadingOverlay?.Stop();
    }

    private void EnableEditing()
    {
        isEditing = true;

        // clone current state to allow cancel
        OriginalSquadre = Squadre.Select(s => new Squadra
        {
            Id = s.Id,
            Nome = s.Nome,
            Color = s.Color,
            Bambini = s.Bambini.Select(b => new Bambino
            {
                Id = b.Id,
                Nome = b.Nome,
                Cognome = b.Cognome,
                Anno = b.Anno
            }).ToList()
        }).ToList();
    }

    private void CancelEditing()
    {
        isEditing = false;

        // restore original state
        Squadre = OriginalSquadre.Select(s => new Squadra
        {
            Id = s.Id,
            Nome = s.Nome,
            Color = s.Color,
            Bambini = s.Bambini.Select(b => new Bambino
            {
                Id = b.Id,
                Nome = b.Nome,
                Cognome = b.Cognome,
                Anno = b.Anno
            }).ToList()
        }).ToList();
    }

    private void RidistriubisciSquadre()
    {
        if (!isEditing) return;

        var tutti = Squadre.SelectMany(s => s.Bambini).ToList();
        var targetSquadre = Squadre.Where(s => s.Id != null).ToList();

        foreach (var s in targetSquadre)
            s.Bambini.Clear();

        var gruppiPerAnno = tutti.GroupBy(b => b.Anno).OrderBy(g => g.Key);
        int index = 0;

        foreach (var gruppo in gruppiPerAnno)
        {
            foreach (var bambino in gruppo.OrderBy(_ => Guid.NewGuid()))
            {
                targetSquadre[index % targetSquadre.Count].Bambini.Add(bambino);
                index++;
            }
        }

        foreach (var s in targetSquadre)
        {
            s.Bambini = s.Bambini
                .OrderByDescending(x => x.Anno)
                .ThenBy(x => $"{x.Cognome} {x.Nome}")
                .ToList();
        }
    }

    [JSInvokable]
    private void OnRemoveJS((int oldIndex, int newIndex, int? from, int? to) indices)
    {
        if (!isEditing) return;

        var squadra = Squadre.Single(x => x.Id == indices.from);
        // If needed, persist the new order in database, or just call StateHasChanged
        Squadre.Single(x => x.Id == indices.to).Bambini.Insert(indices.newIndex, squadra.Bambini[indices.oldIndex]);
        squadra.Bambini.Remove(squadra.Bambini[indices.oldIndex]);
        StateHasChanged();
    }

    private string GetTextColor(string hex)
    {
        if (string.IsNullOrWhiteSpace(hex) || hex.Length < 7 || !hex.StartsWith("#"))
            return "#000000";

        int r = int.TryParse(hex.Substring(1, 2), System.Globalization.NumberStyles.HexNumber, null, out var rr) ? rr : 0;
        int g = int.TryParse(hex.Substring(3, 2), System.Globalization.NumberStyles.HexNumber, null, out var gg) ? gg : 0;
        int b = int.TryParse(hex.Substring(5, 2), System.Globalization.NumberStyles.HexNumber, null, out var bb) ? bb : 0;

        double luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
        return luminance > 0.5 ? "#000000" : "#FFFFFF";
    }

    private void TornaIndietro() => Navigation.NavigateTo("", true);
}