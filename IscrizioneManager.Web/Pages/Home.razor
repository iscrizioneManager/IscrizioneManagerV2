@page "/home"
@using IscrizioneManager.Core.Services
@using IscrizioniManager.Core.Services
@using IscrizioniManager.Models
@using System.Reflection
@using IscrizioneManager.Core.Models
@using IscrizioniManager.Controllers
@inject NavigationManager Navigation
@inject LocalStorageService Storage
@inject IJSRuntime JS

<script>
    function openLinkDirect(url) {
    // crea un link temporaneo e lo clicca
    const a = document.createElement("a");
    a.href = url;
    a.target = "_blank";
    a.rel = "noopener";
    document.body.appendChild(a);
    a.click();
    a.remove();
    }
</script>
<link href="css/Home.css" rel="stylesheet" />

<LoadingView @ref="LoadingOverlay" />

<div class="home-container" style="display:@(IsLoading ? "none" : null)">
    <div class="event-label">
        <strong>@EventName</strong>
    </div>
    <div class="role-label">
        Accesso effettuato come: <strong>@RoleText</strong>
    </div>

    <button class="main-button" @onclick="InserisciIscrizione_Clicked" style="display:@(ShowAdminButtons ? "block" : "none")">
        Nuova iscrizione
    </button>

    <button class="main-button" @onclick="ListaIscritti_Clicked" style="display:@(ShowAdminButtons ? "block" : "none")">
        Lista iscritti
    </button>

    <button class="main-button green" style="display:@((ShowAdminButtons || ShowAnimatoreButtons) ? "block" : "none")">
        <a href="@ExcelLink" target="_blank" rel="noopener" style="color:inherit; text-decoration:none; display:block;">
            Visualizza in Fogli Google
        </a>
    </button>

    <button class="main-button blue" style="display:@((ShowAdminButtons || ShowAnimatoreButtons) ? "block" : "none")">
        <a href="@DriveLink" target="_blank" rel="noopener" style="color:inherit; text-decoration:none; display:block;">
            Cartella Google Drive
        </a>
    </button>

    <button class="main-button logout" @onclick="Logout_Clicked">
        Logout
    </button>
</div>

