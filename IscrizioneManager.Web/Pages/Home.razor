    private string ExcelLink = null;
    private string DriveLink = null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        if (string.IsNullOrEmpty(await Storage.GetItem("jwtToken")) || 
            string.IsNullOrEmpty(await Storage.GetItem("refreshToken")) ||
            string.IsNullOrEmpty(await Storage.GetItem("eventId")) ||
            string.IsNullOrEmpty(await Storage.GetItem("roleId")))
        {
            ClientHolder.Reset();
            Navigation.NavigateTo("login", true);
        }

        IsLoading = true;
        StateHasChanged();

        LoadingOverlay?.Start();

        EventName = await Storage.GetItem("eventDesc");
        var client = ClientHolder.Client;
        var isAdmin = client._roleId == RoleValues.Admin;
        var isAnimatore = client._roleId == RoleValues.Animatore;

        if (client._roleId != null)
        {
            var field = client._roleId.GetType().GetField(client._roleId.Value.ToString());
            var attribute = field?.GetCustomAttribute<System.ComponentModel.DescriptionAttribute>();
            RoleText = attribute?.Description ?? "";
        }

        
        ExcelLink = await GoogleSheetService.GetOrCreateUrlAsync(null, UrlTypes.GoogleSheet);
        DriveLink = await GoogleSheetService.GetOrCreateUrlAsync(null, UrlTypes.GoogleDrive);


        ShowAdminButtons = isAdmin;
        ShowAnimatoreButtons = isAnimatore;

        LoadingOverlay?.Stop();
        IsLoading = false;

        StateHasChanged();
    }


    private async Task Logout_Clicked()
    {
        await Storage.RemoveItem("jwtToken");
        await Storage.RemoveItem("refreshToken");
        await Storage.RemoveItem("eventId");
        await Storage.RemoveItem("eventDesc");
        await Storage.RemoveItem("roleId");

        ClientHolder.Reset();
        Navigation.NavigateTo("login", true);
    }

    private void InserisciIscrizione_Clicked()
    {
        Navigation.NavigateTo("inserisciIscrizione");
    }

    private void ListaIscritti_Clicked()
    {
        Navigation.NavigateTo("iscritti");
